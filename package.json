{
  "name": "dreamdex-perps-market-monitor",
  "version": "1.0.0",
  "description": "Read-only DreamDEX Perps market monitor for Somnia Hideki testnet",
  "type": "module",
  "scripts": {
    "monitor": "node --import tsx src/monitor.ts",
