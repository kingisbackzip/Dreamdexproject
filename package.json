{
  "name": "dreamdex-perps-stale-close-repro",
  "version": "1.0.0",
  "description": "Deterministic reproduction of a stale-close position reversal in dreamdex-bot-kit",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "test:feedback": "node --test scripts/reproduce-offline.mjs scripts/revalidate-selected.mjs",
    "check:feedback": "python3 scripts/validate-feedback.py && npm run test:feedback"
  },
  "keywords": [
    "dreamdex",
    "somnia",
    "perpetuals",
    "markets-sdk",
    "bug-reproduction"
  ],
  "license": "MIT",
  "dependencies": {
    "@somnia-chain/markets-sdk": "0.31.0",
    "viem": "2.38.5"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
